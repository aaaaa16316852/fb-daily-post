# 複製這份內容，貼到 Streamlit Cloud → App → Settings → Secrets
# 本機測試則存成 .streamlit/secrets.toml（已在 .gitignore，不會上傳）

APP_PASSWORD = "你的登入密碼"

GEMINI_API_KEY = "AIza..."          # Google AI Studio 取得
ANTHROPIC_API_KEY = "sk-ant-..."     # console.anthropic.com 取得

# 模型清單：第一個是主模型，後面是 429 時的備援（依序嘗試）
GEMINI_MODELS = ["gemini-3.8-flash", "gemini-3.5-flash"]
CLAUDE_MODELS = ["claude-sonnet-5-5", "claude-haiku-5-5"]

PASS_SCORE = 85
MAX_ROUNDS = 3
USE_SEARCH = true    # Gemini 用 Google 搜尋找熱門關鍵字、查法規

# 簽名檔
LICENSE_NO = "(113)登字第468181號"

# 固定 Hashtag（每篇都會加）
FIXED_HASHTAGS = ["#歸仁土地仲介", "#台南土地", "#台南農地", "#台南建地", "#台南工業地", "#幸福家不動產"]

# 第一則留言的 AI 特助連結
AI_ASSISTANT_URL = "https://www.myhomes.com.tw/mo/ai_qna/16612"
